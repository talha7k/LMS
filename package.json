{
  "name": "enrich-sa",
  "version": "0.1.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo prepare --concurrency 13 && turbo run dev",
    "lint": "turbo run lint",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier . --write",
    "release": "standard-version",
    "ci": "cypress run",
    "dashboard:build": "cd apps/dashboard && pnpm i && PUBLIC_IS_SELFHOSTED=true NODE_OPTIONS='--max-old-space-size=20384' DEPLOYMENT_PROVIDER=docker pnpm build",
    "dashboard:start": "cd apps/dashboard && node build/index.js"
  },
  "license": "MIT",
  "dependencies": {
    "turbo": "^2.8.19"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "standard-version": "^9.5.0",
    "tsconfig": "workspace:*",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^20.19.3"
  }
}
